# =============================================================
# MeroStay .gitignore
# Rule: secrets, dependencies and build outputs are NEVER committed.
# =============================================================

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
!**/.env.example
!**/.env.test.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets/
*.secret
*.secrets

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/
.npm/

# ---------- Generated code ----------
# Prisma client (rebuilt by `npm run db:generate`)
**/src/generated/
# Next.js type declarations (rebuilt by `next dev` / `next build` / `next typegen`)
next-env.d.ts

# ---------- Build outputs ----------
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/
.cache/

# ---------- Testing ----------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
playwright/.auth/

# ---------- Database (local only) ----------
*.db
*.sqlite
*.sqlite3
postgres-data/
pgdata/
*.dump
*.sql.gz

# ---------- User uploads (stored outside git) ----------
uploads/
tmp/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# ---------- Claude Code local settings ----------
.claude/settings.local.json
