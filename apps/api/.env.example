# apps/api/.env: copy this file to `.env` for local development.
# Placeholder values only. Never commit the real `.env`.

# Neon PostgreSQL: paste your connection string from the Neon console
# (Connect button, pooled connection). sslmode=require is mandatory.
# This is the ONLY value you need to change.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional, normally leave unset. The direct (non-pooled) connection used by the
# Prisma CLI is derived automatically from DATABASE_URL by removing "-pooler" from
# the host. Set this only to override that.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional settings (defaults shown)
# NODE_ENV=development
# PORT=4000
# LOG_LEVEL=info

# TEMPORARY until authentication exists (Phase 4). The trip endpoints accept a userId in the
# request body and check no ownership, so they are OFF by default (403 TRIPS_API_DISABLED).
# Default: false (also when unset), in every environment. Set to true ONLY on your own machine
# to try the trip API locally. Never true on a public deployment.
ALLOW_UNAUTHENTICATED_TRIPS_API=false
