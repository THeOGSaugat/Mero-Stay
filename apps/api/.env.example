# apps/api/.env: copy this file to `.env` for local development.
# Placeholder values only. Never commit the real `.env`.

# Neon PostgreSQL: paste your connection string from the Neon console
# (Connect button, pooled connection). sslmode=require is mandatory.
# This is the ONLY value you need to change.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional, normally leave unset. The direct (non-pooled) connection used by the
# Prisma CLI is derived automatically from DATABASE_URL by removing "-pooler" from
# the host. Set this only to override that.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional settings (defaults shown)
# NODE_ENV=development
# PORT=4000
# LOG_LEVEL=info

# Sessions (ADR 0006). REQUIRED: the API refuses to start without SESSION_SECRET.
# Generate a fresh value per environment and keep it secret:  openssl rand -base64 48
SESSION_SECRET=
# Absolute session lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168
# HTTPS-only session cookie. Default: true when NODE_ENV=production (and cannot be false there),
# false otherwise so http://localhost works.
# SESSION_COOKIE_SECURE=false

# Online payments (ADR 0007, ADR 0017). PAYMENT_GATEWAYS: comma list of esewa, khalti, simulated.
# Unset = no online payment (503). "simulated" is a TEST-MODE gateway (marked paid by an API call),
# refused when NODE_ENV=production. Production needs PAYMENT_MODE=production, the keys of every
# gateway listed, and an https PUBLIC_WEB_URL, or the API refuses to start.
# Sandbox credentials and test wallets: docs/development/payments.md (never put real keys here
# in a committed file; this file holds placeholders only).
# PAYMENT_GATEWAYS=esewa,khalti
# PAYMENT_MODE=uat
# Where eSewa and Khalti send customers back (the web app's origin, no trailing slash).
# PUBLIC_WEB_URL=http://localhost:3000
# eSewa ePay v2: merchant product code and secret key (UAT: see docs/development/payments.md).
# ESEWA_PRODUCT_CODE=your-esewa-product-code
# ESEWA_SECRET_KEY=your-esewa-secret-key
# Khalti ePayment v2: the merchant's live or test secret key (test-admin.khalti.com for sandbox).
# KHALTI_SECRET_KEY=your-khalti-secret-key
# Tests only (refused in production): point the adapters at the local fake gateways.
# ESEWA_FORM_URL= ESEWA_STATUS_URL= KHALTI_API_URL=

# Client IP behind proxies (ADR 0014). Browsers reach the API through the web server, which appends
# the address it saw to X-Forwarded-For. The API believes only entries written by these proxies.
# TRUST_PROXY_HOPS: proxies in front of the API (0 = API exposed directly, 1 = the MeroStay web
# server, 2 = web server + one edge/load balancer). TRUST_PROXY_ADDRESSES: the addresses those
# proxies connect from (IPs, CIDR ranges, or loopback / linklocal / uniquelocal). Never "true" or /0.
# REQUIRED in production. Defaults elsewhere: 1 hop from loopback (web server on this machine).
# TRUST_PROXY_HOPS=1
# TRUST_PROXY_ADDRESSES=loopback
# Private storage for verification documents (ADR 0016). Files are never public: the API serves
# them only to the owning partner and to admins. REQUIRED in production.
# local = a directory on this machine (absolute, outside any web root, backed up; one instance).
#   Default outside production: apps/api/.storage (git-ignored).
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/var/lib/merostay/documents
# s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze). The bucket must block
# all public access. S3_ENDPOINT only for non-AWS stores. Leave the keys unset to use the SDK's
# default credentials (e.g. an instance role); otherwise set both. Real keys never go in Git.
# STORAGE_DRIVER=s3
# S3_BUCKET=merostay-documents
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Hold-release worker (`npm run jobs:hold-release:watch`, also started by `npm run dev`):
# seconds between runs (default 60, range 5-3600).
# HOLD_RELEASE_INTERVAL_SECONDS=60

# TESTS ONLY (refused in production): raise the per-client login limit (default 30 per 15 min).
# The E2E suite sets it because every browser logs in from this machine (ADR 0018).
# AUTH_LOGIN_PER_IP_LIMIT=
