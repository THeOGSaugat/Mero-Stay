# apps/api/.env: copy this file to `.env` for local development.
# Placeholder values only. Never commit the real `.env`.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Neon PostgreSQL. Copy both strings from the Neon console (Connect button).
# sslmode=require is mandatory.

# POOLED connection (host contains "-pooler"). Used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require"

# DIRECT connection (no "-pooler"). Used by the Prisma CLI, migrations and
# integration tests. The Prisma CLI does not work through the pooler.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DBNAME?sslmode=require"
