# apps/api/.env.test: the TEST database used by `npm run test:integration`.
# Copy this file to `.env.test`. Never commit the real `.env.test`.
#
# ⚠ Integration tests DELETE EVERYTHING in this database on every run.
#   Use a separate Neon branch (e.g. named `test`), never your dev database.
#   The tests refuse to run if this points at the same database as DATABASE_URL.

# Pooled connection string of the `test` branch (Neon console → Connect). sslmode=require is mandatory.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@EP-TEST-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional: the direct URL is derived automatically by removing "-pooler" from the host.
# TEST_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP-TEST.REGION.aws.neon.tech/DBNAME?sslmode=require"
