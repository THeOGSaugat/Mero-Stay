# apps/web/.env.local: copy this file to `.env.local` for local development.
# Never commit `.env.local`.

# Base URL of the MeroStay API (ADR 0010). Used for
#  - server-side rendering (read at request time), and
#  - the /api/v1/* proxy that browsers call (fixed at BUILD time by next build).
# Set it for both `npm run build` and `npm start`. Server-only (no NEXT_PUBLIC_ prefix): the browser
# only ever sees its own origin. Required in production; defaults to http://localhost:4000 in development.
API_URL=http://localhost:4000
