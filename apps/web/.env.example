# apps/web/.env.local: copy this file to `.env.local` for local development.
# Never commit `.env.local`.

# Base URL of the MeroStay API, used by server-side rendering.
# Server-only (no NEXT_PUBLIC_ prefix): read at request time, never sent to browsers.
# Required in production; defaults to http://localhost:4000 in development.
API_URL=http://localhost:4000
