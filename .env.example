# Root .env: read by Docker Compose for the local PostgreSQL container.
# Copy to `.env` and change the password. These are LOCAL DEVELOPMENT values only.
POSTGRES_USER=merostay
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=merostay
# Host port. Change it if 5432 is already used by another PostgreSQL install
# (and update DATABASE_URL in apps/api/.env to match).
POSTGRES_PORT=5432
